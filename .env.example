# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=landgrab
POSTGRES_PASSWORD=changeme
POSTGRES_DB=landgrab
# Overridden in docker-compose for container networking; use this for local dev
DATABASE_URL=postgresql+asyncpg://landgrab:changeme@localhost:5432/landgrab

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Free APIs ────────────────────────────────────────────────────────────────
# FRED (Federal Reserve Economic Data) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# US Census Bureau — https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# FBI Crime Data — https://api.usa.gov/crime/fbi/cde/ (no key required as of 2024)
FBI_CRIME_API_KEY=

# RentCast — https://app.rentcast.io/app/api-access (50 calls/month free)
RENTCAST_API_KEY=

# API Ninjas — https://api-ninjas.com/ (free tier)
API_NINJAS_KEY=

# ─── Paid APIs (add when ready — adapters gracefully skip if key is missing) ─
# ATTOM Data — https://api.developer.attomdata.com/home
ATTOM_API_KEY=

# GreatSchools — https://www.greatschools.org/api
GREATSCHOOLS_API_KEY=

# Walk Score — https://www.walkscore.com/professional/walk-score-apis.php
WALK_SCORE_API_KEY=

# ─── AI ───────────────────────────────────────────────────────────────────────
# Anthropic Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── Maps ─────────────────────────────────────────────────────────────────────
# Mapbox — https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=

# ─── Email (Celery alert emails) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=alerts@landgrab.io

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Map: viewport width threshold (miles) below which properties auto-load (default: 40)
NEXT_PUBLIC_MAP_BBOX_MILES=40
