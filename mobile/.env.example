# Copy to .env and fill in values
# The API URL should be your machine's LAN IP when testing on a physical device
# (not localhost — the device can't reach it)
EXPO_PUBLIC_API_URL=http://192.168.1.x:8000

# Google OAuth client ID (same value as NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID in the web app)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OpenTelemetry / SigNoz — must be host machine's LAN IP (not localhost)
# Leave empty to disable telemetry
EXPO_PUBLIC_OTEL_ENDPOINT=http://192.168.1.x:4318
EXPO_PUBLIC_OTEL_SERVICE_NAME=landgrab-mobile
